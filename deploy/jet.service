[Unit]
Description=Jet browser home and assistant
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/code/jet
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/home/ubuntu/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/.local/bin/jet --listen 127.0.0.1:8787 --data-dir /home/ubuntu/.local/share/jet --ui-dir /home/ubuntu/code/jet/crates/jet/ui --public-origin https://xchainanalytics.com
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=multi-user.target
